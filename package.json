{
  "name": "shelltime",
  "private": true,
  "version": "0.7.3",
  "description": "Shelltime — low-friction time tracking for project-based work",
  "author": "Adam Tweedie",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/logic.test.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/attentionMonitor.test.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/calendarMonitor.test.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/timesheetXlsx.test.mts",
    "dist": "npm run build && electron-builder --win",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.mradamtweedie.shelltime",
    "publish": { "provider": "github", "owner": "profesr-chaos", "repo": "shelltime" },
    "productName": "Shelltime",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "resources/**"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "runAfterFinish": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Shelltime"
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "date-holidays": "^3.32.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "node-ical": "^0.26.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
